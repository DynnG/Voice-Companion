# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Whisper STT Configuration
WHISPER_MODEL_SIZE=small

# Local preload remains enabled by default. Vercel always skips it.
STT_PRELOAD=true
# Vercel: full URL of a dedicated service implementing the STT /transcribe contract.
# Leave blank locally to use faster-whisper. Protect the remote endpoint at its gateway.
STT_SERVICE_URL=
STT_SERVICE_TOKEN=
# Optional HF Hub authentication (does NOT resolve disk exhaustion).
HF_TOKEN=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=4
WHISPER_LANGUAGE=en

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Kokoro-82M ONNX TTS Configuration
TTS_ENABLED=true
KOKORO_MODEL=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_VOICE=af_bella

# Hosted Turso/libSQL database (required on Vercel; leave unset for local SQLite)
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Set these only in backend/Vercel environment; NEVER use a VITE_ prefix.

# Set this in Vercel before Python startup (optional for local development).
PYTHONDONTWRITEBYTECODE=1

# CPU inference threads (1-8); keep low on shared Railway/serverless CPUs.
KOKORO_CPU_THREADS=2

# FP32 can be faster than INT8 on CPUs without efficient INT8 kernels; benchmark RAM/latency.
KOKORO_MODEL_PRECISION=int8
